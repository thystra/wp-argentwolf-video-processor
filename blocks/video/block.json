{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "argentwolf-video-processor/video",
  "title": "ArgentWolf Video",
  "category": "media",
  "icon": "video-alt3",
  "description": "Choose an existing AWVP Video or bind WordPress video media for local or managed PeerTube delivery.",
  "keywords": [
    "video",
    "media",
    "peertube"
  ],
  "textdomain": "argentwolf-video-processor",
  "attributes": {
    "videoId": {
      "type": "integer",
      "default": 0
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css"
}
